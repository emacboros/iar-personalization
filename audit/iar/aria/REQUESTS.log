d -r line; do\n    [ -z \"$line\" ] && continue\n    first_hhmmss=$(echo \"$line\" | grep -oE \"first=[0-9]{2}:[0-9]{2}:[0-9]{2}Z\" | head -1 | cut -d= -f2)\n    if [ -n \"$first_hhmmss\" ]; then\n      # Anchor the HH:MM:SSZ to TODAY (UTC). EPOCH HAND-CONVERSION IS\n      # FORBIDDEN (law-50): let date(1) do every conversion.\n      eage=$(( NOW - $(date -u -d \"$(date -u +%Y-%m-%d)T${first_hhmmss}\" +%s 2>/dev/null || echo \"$NOW\") ))\n      if [ \"$eage\" -lt 0 ]; then\n        # Episode was yesterday (fleet file written before midnight).\n        eage=$(( eage + 86400 ))\n      fi\n      if [ \"$eage\" -gt 21600 ]; then\n        # Stale: annotate, never silence. The executive sees the\n        # episode existed but is old enough to be history.\n        reasons=\"$reasons STALE-EPISODE($(echo \"$line\" | awk '{print $1}') first=${first_hhmmss} age=$(( eage / 3600 ))h)\"\n        continue\n      fi\n    fi\n    eps=\"$eps$line;\"\n  done < <(grep \"EPISODES-6H:\" \"$FLEET_FILE\" 2>/dev/null | head -3)\n  if [ -n \"$eps\" ]; then\n    [ \"$worst\" -lt 1 ] && { worst=1; reasons=\"$reasons episodes-6h:$eps\"; }\n  fi\nfi\n\n# --- grade ---\ncase \"$worst\" in\n  0) sev=0\n     # v1.5 (c100): surface the fossil contradiction -- a quiet verdict\n\n[t+20:58/60:00 c15/300]"},{"role":"assistant","content":null,"tool_calls":[{"id":"call_wl41qzpl","function":{"index":0,"name":"execute_code_local","arguments":{"command":"SSHOPTS=\"-o UserKnownHostsFile=/tmp/aria_known_hosts -o ConnectTimeout=8 -o BatchMode=yes\"\necho \"=== sophon fleet-check.sh: does it emit EPISODES-6H? (v2.35) ===\"\ntimeout 10 ssh $SSHOPTS root@10.66.0.5 'grep -n \"EPISODES\" /var/home/nacho/repos/iar-personalization/knowledge/aria/bin/fleet-check.sh | head -6; echo \"---\"; grep -n \"EPISODES\" /var/home/nacho/repos/iar-personalization/knowledge/aria/bin/aria-fleet-feed.sh | head -6' 2>&1\necho \"=== sophon: the 09:02Z (06:02 local) fleet run journal ===\"\ntimeout 10 ssh $SSHOPTS root@10.66.0.5 \"journalctl -u aria-fleet-feed.service --since today --no-pager | grep -E 'Starting|FAIL=' | tail -6\" 2>&1"}}}]},{"role":"tool","content"...[+2445 chars]
