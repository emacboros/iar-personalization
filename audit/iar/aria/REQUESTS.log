"arguments":{"command":"SSH=\"ssh -i /root/.ssh/id_ed25519 -o UserKnownHostsFile=/tmp/aria_known_hosts -o ConnectTimeout=8 -o BatchMode=yes\"; timeout 20 $SSH root@10.66.0.5 'cat /etc/systemd/system/aria-fleet-feed.timer 2>/dev/null; echo \"---\"; systemctl cat aria-fleet-feed.service 2>/dev/null | head -15' 2>&1"}}}]},{"role":"tool","content":"[Unit]\nDescription=Aria fleet-check feeder timer (every 6h)\n\n[Timer]\n# 6h cadence: the composite signal is fresh enough for an hourly\n# fear organ (max staleness ~7h, well under the 26h fear threshold),\n# and 4 fleet-check runs/day is a tolerable probe load on frigate\n# (each run pulls one recording per camera).\nOnCalendar=00/6:00:00\nPersistent=true\nRandomizedDelaySec=300\nUnit=aria-fleet-feed.service\n\n[Install]\nWantedBy=timers.target---\n# /etc/systemd/system/aria-fleet-feed.service\n[Unit]\nDescription=Aria fleet-check feeder (runs fleet-check, feeds fear organ)\nWants=network-online.target\nAfter=network-online.target\n# Deliberately NO OnFailure hook: the feeder must never alarm on its\n# own failure -- a dead feeder is detected by the fear organ's\n# fleet-file staleness check (v1.2), not by systemd mail.\n\n[Service]\nType=oneshot\nUser=root\nExecStart=/bin/bash /usr/local/bin/aria-fleet-feed.sh\n# fleet-check runs up to ~7 min (ear check ~2min + probes); give it\n# headroom. A hung run is killed by the script's own timeout 420.\n\n[t+01:22/60:00 c21/300]"}]
