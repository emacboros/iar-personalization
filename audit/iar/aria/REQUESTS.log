ed global index for trailing-100 window; approximate with within-file index\n    idx = {id(x): i for i,x in enumerate(entries)}\n    for l in ents:\n        i = idx[id(l)]\n        n = norm(l)\n        window = [norm(x[1]) for x in entries[max(0,i-100):i]]\n        if any(n == w or (len(n)\u003e30 and n in w) or (len(w)\u003e30 and w in n) for w in window):\n            d += 1\n    print(f\"{day}: {d}/{len(ents)} = {100*d/len(ents):.0f}%\")\nEOF"}}}]},"done":false}\n{"model":"glm-5.3-flash","created_at":"2026-09-21T16:18:03.552973413Z","message":{"role":"assistant","content":""},"done":false}\n{"model":"glm-5.3-flash","created_at":"2026-09-21T16:18:03.642407737Z","message":{"role":"assistant","content":""},"done":true,"done_reason":"stop","total_duration":6989212922,"prompt_eval_count":42742,"prompt_eval_cached_count":35840,"eval_count":662}\n(c2b03e48ed5041c335c142a5876ef812 . 649)
