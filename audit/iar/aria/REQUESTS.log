fence-state-writeback (state)'''\nassert old in src, \"anchor not found\"\nsrc = src.replace(old, helper, 1)\n\n# Insert the call in the cycle exit path, before the state is cleared.\ncycle_old = '''          (with-current-buffer cycle-buf\n            (iar--usage-write-log-now))\n          (setq iar--cycle-state nil)\n          (kill-emacs exit-code))))))\n\n;;; --- Global fence registration ---'''\ncycle_new = '''          (with-current-buffer cycle-buf\n            (iar--usage-write-log-now))\n          ;; c323 orphan fix v2: dump any request still in flight\n          ;; (the post-close re-send, a delegate's request, a summary\n          ;; request racing the grace window) BEFORE kill-emacs\n          ;; destroys the process buffers. The c320 close-time dump\n          ;; was a production no-op: at close time the live request\n          ;; was the ECHO's, already dead -- the orphan is the\n          ;; request sent AFTER the close (c322 live census).\n          (iar--cycle-exit-dump)\n          (setq iar--cycle-state nil)\n          (kill-emacs exit-code))))))\n\n;;; --- Global fence registration ---'''\nassert cycle_old in src, \"cycle exit anchor not found\"\nsrc = src.replace(cycle_old, cycle_new, 1)\n\n# Insert in the one-shot exit path too.\nos_old = '''          (with-current-buffer os-buf\n            (iar--usage-write-log-now))\n          (setq iar--one-shot-state nil)\n          (kill-emacs exit-code))))))'''\nos_new = '''          (with-current-buffer os-buf\n            (iar--usage-write-log-now))\n          ;; c323 orphan fix v2: same exit-dump as the cycle path --\n          ;; the one-shot exit has the same in-flight-request window.\n          (iar--cycle-exit-dump)\n          (setq iar--one-shot-state nil)\n          (kill-emacs exit-code))))))'''\nassert os_old in src, \"one-shot exit anchor not found\"\nsrc = src.replace(os_old, os_new, 1)\n\nopen('emacs.d/init.d/agent/iar-agent-cycle.el','w').write(src)\nprint(\"OK: helper + 2 exit calls inserted\")\nEOF"}}}]},{"role":"tool","content":"[14:51:58] OK: helper + 2 exit calls inserted\n\n[t+10:22/60:00 c172/300]"},{"role":"assista...[+1777 chars]
