gt 10800 ]; then\n629:    echo \"ATS-STALE: ats-latest.out is ${ATS_AGE}s old (>3h) -- scanner not running? (report, not fail)\"\n630-  else\n631-    awk '!/^=/ && NF>=2 {split($2,a,\"/\"); c[$1\" \"a[1]\"/\"a[2]]++} END {for (k in c) print k, c[k]}' \"$ATS_OUT\" \\\n632-      | awk '{cnt[$1]+=$3} END {for (cam in cnt) print cam, cnt[cam]}' \\\n633-      | while read -r cam n; do\n634-          if [ \"$n\" -gt 2 ]; then\n635:            echo \"FAIL-LINE: $cam RECORDER-AUDIO-HOURS: $n dead hour-dirs in ats 24h window (>2) -- recorder-side audio death persistent; live-sample detectors blind to it (c146 census class)\"; FAIL=1\n636-          else\n637-            echo \"$cam ats: $n dead hour-dir(s) in 24h (transient)\"\n638-          fi\n639-        done\n640-  fi\n641-else\n642:  echo \"ats-latest.out missing -- ats scan not installed? (report, not fail: 1a/1b cover live deafness)\"\n643-fi\n644-\n645-# --- 2. IDENTITY WATCH (pixels, not metadata) ---\n646-echo \"-- identity watch --\"\n647-WDIR=/tmp/aria-watch\n648-$P exec frigate sh -c \"mkdir -p $WDIR && rm -f $WDIR/*.jpg /media/frigate/aria_watch_*.jpg 2>/dev/null\" 2>/dev/null\n649-\n650-# 2a. direct grab of .101 (container ffmpeg: host ffmpeg lacks hevc)\n651-grab=$($P exec frigate sh -c \"timeout 25 /usr/lib/ffmpeg/7.0/bin/ffmpeg -y -loglevel error -rtsp_transport tcp -i 'rtsp://thingino:thingino@192.168.2.101/ch0' -frames:v 1 $WDIR/direct.jpg && cp $WDIR/direct.jpg /media/frigate/aria_watch_direct.jpg && echo OK\" 2>/dev/null)\n652-if [ \"$grab\" != \"OK\" ]; then echo \"FAIL-LINE: DIRECT-GRAB FAIL (is .101 up?)\"; FAIL=1; fi\n653-\n654-# 2b. ext1 newest segment tail (host path -> container path)\n655-n=$(find $R/$TODAY -path \"*exterior_1*\" -name \"*.mp4\" 2>/dev/null | sort | tail -1)\n656-if [ -n \"$n\" ]; then\n657-  nc=\"${n/\\/home\\/nacho\\/containers\\/frigate\\/storage//media/frigate}\"\n658-  tail=$($P exec frigate sh -c \"timeout 25 /usr/lib/ffmpeg/7.0/bin/ffmpeg -y -loglevel error -sseof -2 -i '$nc' -frames:v 1 $WDIR/seg.jpg && cp $WDIR/seg.jpg /media/frigate/aria_watch_seg.jpg && echo OK\" 2>/dev/null)\n659-  # v2.19 (c170): ...[+5489 chars]
