ist-put info :tool-calls-captured t)))\n            (if (and reasoning (not (eq reasoning :null)))\n                (plist-put info :reasoning\n                           (concat (plist-get info :reasoning) reasoning))\n              (if (eq 'in (plist-get info :reasoning-block))\n                  (plist-put info :reasoning-block t)\n                (plist-put info :reasoning-block nil)))\n            (unless (eq done :json-false)\n              ;; Ollama mid-stream error (i.ar relay 0033, 2026-09-11):\n              ;; the server can send {\"error\":\"...\"} as a bare JSON\n              ;; chunk (HTTP 200, no done field). The old loop ignored\n              ;; the :error key entirely: the chunk fell through,\n              ;; gptel--ollama-update-tokens published 0/0 tokens from\n              ;; its (or ... 0) defaults, curl exited 0, and the request\n              ;; completed \"successfully\" with an empty response -- a\n              ;; dead generation wearing a clean end's clothes\n              ;; (continuo c172: tombstoned \"[TIMED OUT] after 0s\" by\n              ;; the 0/0 guard on stale stop-reason + the error chunk's\n              ;; own 0/0). Capture the error into info (the FSM's\n              ;; gptel--error-p routes TYPE -> ERRS), set an honest\n              ;; status, and skip the token update so the error chunk\n\n[t+06:32/60:00 c102/300]"},{"role":"assistant","content":null,"tool_calls":[{"id":"call_3z5ryjky","function":{"index":0,"name":"execute_code_local","arguments":{"command":"echo \"=== I have the full picture of the streaming path. Now: where does the cycle FSM see the response and decide? The early-abort design: in gptel-curl--parse-stream, track thinking-only chunk streak; if >N thinking chunks with no content/tool_calls, signal an abort. But is there an existing abort mechanism? The watchdog aborts stalled streams. Where is that? ===\"; grep -rn \"stalled stream\\|Aborting stalled\" /root/.emacs.d/gptel-fork/*.el /root/i.ar/emacs.d