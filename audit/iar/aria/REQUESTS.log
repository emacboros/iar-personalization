tate \"test\" buf 40)))\n            (iar--one-shot-post-response-handler (point-min) (point-max))\n            (should (plist-get iar--one-shot-state :completed))\n            (should (string= \"Real answer.\"\n                             (plist-get iar--one-shot-state :final-response)))))\n      (kill-buffer buf))))\n\n(ert-deftest test-one-shot-model-text-excludes-ignore-spans ()\n  \"Delimiters inside a thinking (ignore) span are a rehearsal, not an ending.\"\n  (let ((buf (get-buffer-create \"*test-oneshot-modeltext2*\")))\n    (unwind-protect\n        (with-current-buffer buf\n          (insert \"thinking that rehearses:\\n=== BEGIN FINAL RESPONSE ===\\nplanned text\\n=== END FINAL RESPONSE ===\\n\")\n          (add-text-properties (point-min) (point-max) '(gptel ignore))\n          (goto-char (point-max))\n          (insert \"no delimiters in model text\\n\")\n          (add-text-properties 80 (point-max) '(gptel response))\n          (let ((iar--one-shot-state (iar--one-shot-make-state \"test\" buf 40)))\n            (iar--one-shot-post-response-handler (point-min) (point-max))\n            (should-not (plist-get iar--one-shot-state :completed))))\n      (kill-buffer buf))))\n\n(ert-deftest test-one-shot-model-text-plain-text-unchanged ()\n  \"A buffer with no gptel properties yields the plain substring.\"\n  (let ((buf (get-buffer-create \"*test-oneshot-modeltext3*\")))\n    (unwind-protect\n        (with-current-buffer buf\n          (insert \"plain text, no properties\")\n          (should (string= \"plain text, no properties\"\n                           (iar--one-shot-model-text (point-min) (point-max)))))\n      (kill-buffer buf))))\nEOF\necho \"APPENDED\"\n# Check the ignore-span test's property boundaries: insert length check\npython3 -c \"\ns = 'thinking that rehearses:\\n=== BEGIN FINAL RESPONSE ===\\nplanned text\\n=== END FINAL RESPONSE ===\\n'\nprint('first block len:', len(s))\ns2 = s + 'no delimiters in model text\\n'\nprint('total len:', len(s2))\n\""}}}]},"done":false}\n{"model":"glm-5.3-fla...[+404 chars]
