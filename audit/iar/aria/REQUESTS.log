(split parameter files) (loaded before init.d modules).\n(defvar iar-prompts-path nil\n  \"Relative path to shared prompt templates.\")\n\n(defun iar--load-prompt (name)\n  \"Load a prompt template from the common prompts directory.\nNAME is the prompt file name without extension (e.g., \\\"darwin_cycle\\\").\nReturns the file content as a string, with trailing whitespace trimmed.\nSignals an error if the file is not found.\"\n  (let* ((prompts-dir (expand-file-name iar-prompts-path user-emacs-directory))\n         (prompt-path (expand-file-name (format \"%s.org\" name) prompts-dir)))\n    (unless (file-exists-p prompt-path)\n      (error \"Prompt template '%s' not found at %s\" name prompt-path))\n    (with-temp-buffer\n      (insert-file-contents prompt-path)\n      ;; Return the raw content, trimming trailing newline for clean format usage.\n      (string-trim-right (buffer-string) \"\\n\"))))\n\n(provide 'iar-prompt-loader)\n[t+02:27/60:00 c67/300]"},{"role":"assistant","content":null,"tool_calls":[{"id":"call_1a0psikl","function":{"index":0,"name":"execute_code_local","arguments":{"command":"ls /root/i.ar/emacs.d/agents.d/common/ 2>/dev/null | head -20; echo \"===\"; cat /root/i.ar/emacs.d/agents.d/common/delegate_continue.org 2>/dev/null"}}}]},{"role":"tool","content":"[20:06:41] agent_cycle_continue.org\ndelegate_continue.org\ndelegated_task.org\nloop_chain_block.org\nloop_chain_stop.org\nloop_hard_stop.org\nloop_soft_block.org\nmount_info.org\nunknown_tool.org\n===\nYour last response did not include any tool calls, but the task may be complete.\n\nIf the task is complete, end your response with the DELEGATION RESULT marker and your concise summary:\n\n=== DELEGATION RESULT ===\n[Your concise summary here.]\n\nIf the task is NOT complete, take action now. Call the available tools instead of describing what you plan to do. Read the relevant files, run commands, or delegate as needed. Do not narrate -- act.\n[t+02:29/60:00 c68/300]"}]
