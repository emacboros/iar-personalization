nownHostsFile=$KH -o ConnectTimeout=8 root@10.66.0.5 'cat /var/lib/aria-fleet/wrnrate-puller.sh' 2>&1"}}}]},{"role":"tool","content":"[22:24:58] #!/bin/bash\n# wrnrate-puller.sh v1.1 (aria c142) -- hourly WRN-rate series per cam\n# Appends: <utc-epoch> <utc> <cam> <count> to /var/lib/aria-fleet/wrnrate.log\n# go2rtc dial-failure WRNs per camera IP from frigate container logs.\n# podman logs timestamps are LOCAL (-03); converted to UTC here.\n# Single-instance via pidfile.\nOUT=/var/lib/aria-fleet/wrnrate.log\nPID=/var/lib/aria-fleet/wrnrate.pid\n[ -f \"$PID\" ] && kill -0 \"$(cat \"$PID\")\" 2>/dev/null && exit 0\necho $$ > \"$PID\"\ntrap 'rm -f \"$PID\"' EXIT\nNOW=$(date +%s)\nCUTOFF_EPOCH=$(( NOW - 3600 ))\nrunuser -l nacho -c \"podman logs --since 65m frigate 2>&1\" | grep \"WRN\" | grep \"producer.go:170\" | \\\nwhile IFS= read -r line; do\n  # podman ts is LOCAL; convert to epoch via date -d\n  ts=$(echo \"$line\" | grep -oE '^[0-9-]{10} [0-9:]{8}' | head -1)\n  cam=$(echo \"$line\" | grep -oE '192\\.168\\.2\\.[0-9]+' | head -1)\n  [ -n \"$ts\" ] || continue\n  ep=$(date -d \"$ts\" +%s 2>/dev/null) || continue\n  [ \"$ep\" -ge \"$CUTOFF_EPOCH\" ] && echo \"$cam\"\ndone | sort | uniq -c | \\\nwhile read count cam; do\n  echo \"$NOW $(date -u -d @$NOW '+%Y-%m-%dT%H:%M:%SZ') $cam $count\" >> \"$OUT\"\ndone\nTOTAL=$(runuser -l nacho -c \"podman logs --since 65m frigate 2>&1\" | grep -c \"WRN.*producer.go:170\")\necho \"$NOW $(date -u -d @$NOW '+%Y-%m-%dT%H:%M:%SZ') TOTAL $TOTAL\" >> \"$OUT\"\n\n[t+03:25/60:00 c47/300]"}]
