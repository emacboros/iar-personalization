MDD-<filer>-NNNN-slug.md (per-filer) or legacy\n  # YYYYMMDD-NNNN-slug.md. The id is the filer+seq token. Extracted by\n  # anchored pattern, never substring (census-echo law, c71).\n  local b=\"$1\"\n  case \"$b\" in\n    [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[a-z]*-[0-9][0-9][0-9][0-9]-*)\n      echo \"${b#????????-}\" | cut -d- -f1-2 ;;\n    [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]-*)\n      echo \"${b#????????-}\" | cut -d- -f1 ;;\n    *) echo \"\" ;;\n  esac\n}\n\nfind_req() { # find_req <id> -> prints path or dies\n  local id=\"$1\" hit=\"\" f b tok\n  for s in $STATES; do\n    for f in \"$ROOT/$s\"/*.md; do\n      [ -e \"$f\" ] || continue\n      tok=$(short_id \"$(basename \"$f\")\")\n      [ \"$tok\" = \"$id\" ] && hit=\"$f\"\n    done\n  done\n  [ -n \"$hit\" ] || die \"no request matching id '$id'\"\n  echo \"$hit\"\n}\n\ncmd_file() {\n  local class=\"$1\" title=\"$2\" bodyfile=\"$3\"\n  echo \"$CLASSES\" | grep -qw \"$class\" || die \"bad class '$class' (valid: $CLASSES)\"\n  if [ \"$bodyfile\" = \"-\" ]; then\n    bodyfile=\"$(mktemp /tmp/relay-body.XXXXXX)\"\n    cat > \"$bodyfile\"\n  else\n    [ -f \"$bodyfile\" ] || die \"body file not found: $bodyfile\"\n=== open filings ===\n20260911-aria-0042-root-git-status-from-yoga-re-poisons-sop.md\n20260912-aria-0045-nic-10m-link-nic-sampler-er605-logs.md\n20260912-aria-0046-continuo-repetition-census----stimulus-q.md\n20260912-aria-0055-10m-link-origin-story--flap-storm-s.md\n20260912-aria-0059-frigate-8971-85548555-internet-exposed-v.md\n20260913-aria-0060-go2rtc-upstream-issue-draft----ratify-be.md\n20260913-aria-0062-onvif-sweep-050058z--dropbear-burst----c.md\n20260914-aria-0063-camera-102-exterior2-power-dead-0200z-09.md\n20260914-aria-0064-go2rtc-rtsp-port-probes----unsupported-m.md\n20260914-aria-0065-ollamacom-weekly-quota-hit-09-13----cred.md\n20260914-aria-0066-continuo-digest-writes-to-arias-top-leve.md\n20260914-aria-0068-stale-digestproposedmd-is-an-echo-reserv.md\n20260