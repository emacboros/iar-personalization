ndly_name: Interior 1\n    ffmpeg:\n      inputs:\n        - path: rtsp://127.0.0.1:8554/interior_1\n          input_args: preset-rtsp-restream\n          roles:\n            - detect\n            - record\n    detect:\n      width: 1280\n      height: 720\n    live:\n      streams:\n        Stream 1: interior_1\n  interior_2:\n    enabled: true\n    friendly_name: Interior 2\n    ffmpeg:\n      inputs:\n        - path: rtsp://127.0.0.1:8554/interior_2\n          input_args: preset-rtsp-restream\n          roles:\n            - detect\n            - record\n    detect:\n      width: 1280\n      height: 720\n    live:\n      streams:\n        Stream 1: interior_2\n  interior_3:\n    enabled: true\n    friendly_name: Interior 3\n    ffmpeg:\n      inputs:\n        - path: rtsp://127.0.0.1:8554/interior_3\n          input_args: preset-rtsp-restream\n          roles:\n            - detect\n            - record\n\n[t+04:49/60:00 c73/300]"},{"role":"assistant","content":null,"tool_calls":[{"id":"call_equspvsm","function":{"index":0,"name":"execute_code_local","arguments":{"command":"timeout 25 ssh -i /root/.ssh/id_ed25519 -o UserKnownHostsFile=/tmp/aria_known_hosts -o StrictHostKeyChecking=no root@10.66.0.5 'nvidia-smi --query-gpu=memory.used,memory.total,utilization.gpu --format=csv,noheader 2>&1; echo ---; nvidia-smi 2>&1 | grep -E \"frigate|ffmpeg\" | head -5' 2>&1"}}}]},{"role":"tool","content":"[20:07:27] 9244 MiB, 10240 MiB, 16 %\n---\n|    0   N/A  N/A          439736      C   frigate.detector:onnx                   396MiB |\n|    0   N/A  N/A         2275914      C   /usr/lib/ffmpeg/7.0/bin/ffmpeg          269MiB |\n|    0   N/A  N/A         2276418      C   /usr/lib/ffmpeg/7.0/bin/ffmpeg          269MiB |\n|    0   N/A  N/A         2276468      C   /usr/lib/ffmpeg/7.0/bin/ffmpeg          269MiB |\n|    0   N/A  N/A         2288488      C   /usr/lib/ffmpeg/7.0/bin/ffmpeg          269MiB |\n\n[t+04:52/60:00 c74/300]"},{"role":"assistant","content":null,"tool_calls"