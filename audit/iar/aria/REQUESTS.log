rose instead of native tool_calls; gptel parses tools=0 and the tick\n;; looks like a successful chat tick while nothing executed. This module\n;; detects the pattern, logs it to REQUESTS.log, and fires\n;; iar-text-mode-detected-functions. Loads after iar-request-log\n;; (uses iar--reqlog-append).\n(load (expand-file-name \"iar-text-mode-detector.el\" init-tool-call-dir))\n\n=== tool-limits.el owns the defcustoms -- check ===\n88:(defcustom iar-request-watchdog-enabled t\n89:  \"When non-nil, the request watchdog aborts stalled gptel requests.\n91:in flight forever and the session hangs silently. The watchdog\n\n[t+10:25/60:00 c188/300]"},{"role":"assistant","content":null,"tool_calls":[{"id":"call_ns94lfwk","function":{"index":0,"name":"execute_code_local","arguments":{"command":"cd /root/i.ar/emacs.d && sed -n '85,110p' configs/tool-limits.el"}}}]},{"role":"tool","content":"[12:48:45] ;; Request Watchdog Parameters (Track A1)\n;; =============================================================================\n\n(defcustom iar-request-watchdog-enabled t\n  \"When non-nil, the request watchdog aborts stalled gptel requests.\nA stalled request (dead network stream, hung server) otherwise sits\nin flight forever and the session hangs silently. The watchdog\naborts it via `gptel-abort', logs what was in flight, and inserts a\nnotice into the gptel buffer so the agent sees the abort.\nSet to nil to disable (not recommended).\"\n  :type 'boolean\n  :safe #'booleanp\n  :group 'iar)\n\n(defcustom iar-request-idle-timeout 180\n  \"Seconds without stream data before aborting a streaming request.\nStreaming requests call the process filter on every chunk; no calls\nfor this many seconds means the stream died mid-response.\nnil disables the idle check.\"\n  :type '(choice (integer :tag \"Seconds\")\n                 (const :tag \"Disabled\" nil))\n  :safe #'iar--positive-integer-or-nil-p\n  :group 'iar)\n\n(defcustom iar-request-total-timeout 900\n  \"Seconds without ANY data before aborting a request.\n\n[t+10:26/60:00 c189/300]"}]
[2026-09-18 12:48:49] REQ 260918123819-190 RESPONSE http=200 body_tail={"model":"glm-5.3-flash","created_at":"2026-09-18T12:48:49.731329445Z","message":{"role":"assistant","content":"","tool_calls":[{"id":"call_vuku3w8z","function":{"index":0,"name":"execute_code_local","arguments":{"command":"cd /root/i.ar/emacs.d \u0026\u0026 python3 - \u003c\u003c'EOF'\n# 1. Add defcustoms to configs/tool-limits.el after the watchdog block\np = 'configs/tool-limits.el'\ns = open(p).read()\nanchor = \"(defcustom iar-request-total-timeout 900\"\nidx = s.find(anchor)\nassert idx \u003e 0\ninsert = ''';; Thinking-Loop Guard (relay 0085 option c, aria c55): early-abort\n;; runaway reasoning streams. nemotron-3-super's thinking runs away\n;; on a rising share of continuo's cycles (0%-\u003e54% over 4 days,\n;; 09-15..09-18): a single response streams 1.2M+ chars of reasoning\n;; with no content and no tool calls, hits the 32768 num_predict cap,\n;; and the cycle dies (exit 1, no grace). This guard aborts the\n;; stream EARLY -- after max-chars of reasoning with no output --\n;; converting a ~10-minute, 32k+-token death into a ~2-minute, ~4k-\n;; token one. Healthy per-turn thinking is \u003c2k chars (continuo\n;; corpus 09-15..09-17); the threshold sits 8x above that and 75x\n;; below the smallest observed runaway.\n(defcustom iar-thinking-loop-guard-enabled t\n  \"When non-nil, abort reasoning streams that exceed\n`iar-thinking-loop-max-chars' with no content or tool calls.\"\n  :type 'boolean\n  :safe #'booleanp\n  :group 'iar)\n\n(defcustom iar-thinking-loop-max-chars 16000\n  \"Reasoning chars allowed since the last real output before the\nthinking-loop guard aborts the stream.\"\n  :type 'integer\n  :safe #'integerp\n  :group 'iar)\n\n'''\ns = s[:idx] + insert + s[idx:]\nopen(p,'w').write(s)\nprint(\"tool-limits patched\")\n\n# 2. Add the load to init.el after the watchdog load\np2 = 'init.el'\ns2 = open(p2).read()\nanchor2 = '(load (expand-file-name \"iar-request-watchdog.el\" init-tool-call-dir))'\nidx2 = s2.find(anchor2)\nassert idx2 \u003e 0\ninsert2 = anchor2 + '''\n\n;; Thinking-loop guard (relay 0085, aria c55): early-abort runaway\n;; reasoning streams (nemotron thinking-only truncation class). Loads\n;; after the watchdog (same abort path, complementary failure class:\n;; the watchdog catches DEAD streams, this catches LIVE runaway ones).\n(load (expand-file-name \"iar-thinking-loop-guard.el\" init-tool-call-dir))'''\ns2 = s2.replace(anchor2, insert2, 1)\nopen(p2,'w').write(s2)\nprint(\"init.el patched\")\nEOF"}}}]},"done":false}\n{"model":"glm-5.3-flash","created_at":"2026-09-18T12:48:49.732404707Z","message":{"role":"assistant","content":""},"done":false}\n{"model":"glm-5.3-flash","created_at":"2026-09-18T12:48:49.812792413Z","message":{"role":"assistant","content":""},"done":true,"done_reason":"stop","total_duration":3613810885,"prompt_eval_count":120114,"prompt_eval_cached_count":112000,"eval_count":620}\n(aea2cad58ef8f63e81c2ce5bb2451d7c . 648)
