\n  (let* ((buf (generate-new-buffer \" *t502*\"))\n         (proc (make-process :name \"t502\" :command nil :buffer buf))\n         (fsm (gptel-make-fsm :table '((INIT . ((t . DONE))))\n                              :handlers '((DONE))))\n         (info (list :uuid \"uuid\"\n                     :backend (alist-get 'ollama gptel-test-backends)\n                     :callback (lambda (_r _i) nil)))\n         (signalled nil))\n    (setf (gptel-fsm-info fsm) info\n          (alist-get proc gptel--request-alist) (list fsm))\n    (with-current-buffer buf\n      (insert \"HTTP/1.1 502 Bad Gateway\\\\nserver: nginx\\\\n\\\\n\")\n      (insert \"\u003chtml\u003e\u003cbody\u003e502\u003c/body\u003e\u003c/html\u003e\\\\n(uuid . 1)\"))\n    (cl-letf* (((symbol-function 'process-status) (lambda (_) 'exit))\n               ((symbol-function 'process-exit-status) (lambda (_) 0)))\n      (condition-case err\n          (gptel-curl--stream-cleanup proc nil)\n        (error (setq signalled (format \"%S\" err)))))\n    (setf (alist-get proc gptel--request-alist nil t) nil)\n    (delete-process proc)\n    (when (buffer-live-p buf) (kill-buffer buf))\n    (should (null signalled))))\n'''\nwith open(\"test-stream-cleanup-guard.el\", \"w\") as f:\n    f.write(content)\nprint(\"test file written\")\nPYEOF\nrm -f /tmp/stream-cleanup-502-test.el /tmp/stream-cleanup-uuid-nil-test.el /tmp/stream-cleanup-crash-test.el; ls -la test-stream-cleanup-guard.el"}}}]},"done":false}\n{"model":"glm-5.3-flash","created_at":"2026-09-18T11:40:49.411940837Z","message":{"role":"assistant","content":""},"done":false}\n{"model":"glm-5.3-flash","created_at":"2026-09-18T11:40:49.496947453Z","message":{"role":"assistant","content":""},"done":true,"done_reason":"stop","total_duration":7108701804,"prompt_eval_count":138245,"prompt_eval_cached_count":129920,"eval_count":847}\n(5c1617a62788bc5c94bc43c7dc5b2acc . 648)
