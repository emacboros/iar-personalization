 >&2; exit 2; fi\n\n# ---- Pass 1: claim extraction + shingle census -------------------------\n# Claim sentence = line with a verification verb AND an event marker\n# (digits or a path-like token). Structural anchor: full line, not substring.\nCLAIMS=$(grep -hE \"^[^*#]\" \"$JOURNAL\" 2>/dev/null \\\n  | grep -iE \"verified|confirmed|fired|landed|passed\" \\\n  | grep -E \"[0-9]\" | sed 's/^[[:space:]]*//' | sort -u)\n\n# 5-word shingles per claim line\ndeclare -A SHINGLE_DAYS   # shingle -> comma list of days (from journal entry headers, best effort)\ndeclare -A SHINGLE_LINES  # shingle -> example line\n\n# Journal day attribution: walk entries; header lines start with \"* 2026-\"\nCUR_DAY=\"unknown\"\nwhile IFS= read -r line; do\n  if [[ \"$line\" =~ ^\\*[[:space:]]+(2026-[0-9]{2}-[0-9]{2}) ]]; then\n    CUR_DAY=\"${BASH_REMATCH[1]}\"\n  fi\n  # claim line?\n  if echo \"$line\" | grep -qiE \"verified|confirmed|fired|landed|passed\" \\\n     && echo \"$line\" | grep -qE \"[0-9]\"; then\n    L=$(echo \"$line\" | sed 's/^[[:space:]]*//' | cut -c1-300)\n    # shingles\n    echo \"$L\" | tr ' ' '\\n' | awk 'NF' > /tmp/srd_words.$$\n    N=$(wc -l < /tmp/srd_words.$$)\n    for ((i=0; i<=N-5; i++)); do\n      S=$(sed -n \"$((i+1)),$((i+5))p\" /tmp/srd_words.$$ | tr '\\n' ' ' | sed 's/ $//')\n      # skip shingles that are pure boilerplate\n      case \"$S\" in\n        *\"bass line by monitoring\"*) continue;;\n        *\"held the bass line\"*) continue;;\n      esac\n      SHINGLE_DAYS[\"$S\"]=\"${SHINGLE_DAYS[$S]:+${SHINGLE_DAYS[$S]},}$CUR_DAY\"\n      SHINGLE_LINES[\"$S\"]=\"$L\"\n    done\n    rm -f /tmp/srd_words.$$\n  fi\ndone < \"$JOURNAL\"\n\n# ---- Pass 2: receipt cross-check ---------------------------------------\necho \"=== STALE-RECEIPT CENSUS: $AGENT ($(date -u +%Y-%m-%dT%H:%MZ)) ===\"\necho \"root: $ROOT\"\necho\nCAND=0\nfor S in \"${!SHINGLE_DAYS[@]}\"; do\n  DAYS=\"${SHINGLE_DAYS[$S]}\"\n  # unique days\n  UD=$(echo \"$DAYS\" | tr ',' '\\n' | sort -u | tr '\\n' ' ')\n  ND=$(echo $UD | wc -w)\n  [ \"$ND\" -lt 2 ] && continue   # single-day claims: not repetition\n  # skip PULSE-only no...[+10501 chars]
