(iar--usage-reset)\n          (setq iar--usage-requests 3 iar--usage-input-tokens 100\n                iar--usage-output-tokens 40 iar--usage-model \"m\")\n          (should (eq (iar--usage-write-log-now) t))\n          ;; The bare remote now has the belt commit: VISIBLE, not just\n          ;; durable on the checkout.\n          (let ((default-directory bare-dir))\n            (let ((out (generate-new-buffer \" *bare-log*\")))\n              (call-process \"git\" nil (list out t) nil \"log\" \"--oneline\" \"-2\")\n              (let ((text (with-current-buffer out (buffer-string))))\n                (kill-buffer out)\n                (should (string-match-p \"belt #2 durability\" text))))))\n      (delete-directory tmpdir :recursive))))\n\n\n[t+15:55/60:00 c71/300]"},{"role":"assistant","content":null,"tool_calls":[{"id":"call_igmv5qb4","function":{"index":0,"name":"execute_code_local","arguments":{"command":"timeout 25 ssh -o UserKnownHostsFile=/tmp/aria_known_hosts -o BatchMode=yes root@10.66.0.5 'echo \"=== THE LEAK HYPOTHESIS: make-temp-file respects TMPDIR. If the aria cycle ran the test suite with TMPDIR unset/odd... no wait. The audit shows git init with CWD=emacs.d. Which test has default-directory=emacs.d when git init runs? NONE of these (they bind default-directory to tmpdir). ===\"; echo \"=== BUT: what about tests that DON'\"'\"'T bind default-directory and call-process git without cd? Search for call-process git WITHOUT default-directory binding in tests ===\"; grep -rn \"call-process \\\"git\\\"\" /var/home/nacho/repos/i.ar/emacs.d/test/*.el | grep -v \"default-directory\" | head -12' 2>&1 | head -18"}}}]},{"role":"tool","content":"[00:54:32] === THE LEAK HYPOTHESIS: make-temp-file respects TMPDIR. If the aria cycle ran the test suite with TMPDIR unset/odd... no wait. The audit shows git init with CWD=emacs.d. Which test has default-directory=emacs.d when git init runs? NONE of these (they bind default-directory to tmpdir). ===\n=== BUT: what about t