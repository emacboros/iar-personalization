hen it fires (2026-08-31: 11\n# silent tripwire blocks, 1h50m of dead heartbeat, nobody watching).\nOnFailure=agent-failure@%n.service\n\n[Service]\nType=oneshot\nUser=nacho\n# Tripwire AUTO-HEAL (2026-09-03, Nacho approved): root-owned files\n# in the mount trees are chowned to nacho, flagged to syslog (and the\n# hourly digest via OnFailure if the cycle still fails), and the\n# cycle PROCEEDS. The block era ended: the writer was identified\n# (agent root-ssh git, 4 offenses), and blocking cost 65+ cycles and\n# 8+ hours of dead heartbeat on Sep 2 alone. Healing is a 2-second\n# speed bump; blocking was an outage. Evidence: journal Sep 2\n# 12:17-20:50 -03, 65 consecutive exit-78.\nExecStartPre=+/bin/bash -c \"found=$(find /var/home/nacho/repos /home/nacho/repos -user root 2>/dev/null); if [ -n \\\"$found\\\" ]; then echo \\\"ROOT-OWNED FILES AUTO-HEALED (was: blocking):\\\"; echo \\\"$found\\\"; find /var/home/nacho/repos /home/nacho/repos -user root -exec chown nacho:nacho {} + 2>/dev/null; chcon -R system_u:object_r:container_file_t:s0 /var/home/nacho/repos/iar-personalization/.git /var/home/nacho/repos/i.ar/.git /home/nacho/repos/iar-prod/.git 2>/dev/null; logger -t aria-cycle-tripwire \\\"auto-healed root-owned files: $(echo \\\"$found\\\" | head -3 | tr \\\"\\n\\\" \\\";\\\")\\\"; fi\"\n# glm-5.3-flash:cloud for cycles (cheaper units); interactive stays on glm-5.3:cloud.\nExecStart=/usr/local/bin/aria-cycle-rotate.sh\nWorkingDirectory=/var/home/nacho/repos/i.ar\nTimeoutStartSec=1980\n\n[Install]\nWantedBy=multi-user.target\n\n# /usr/lib/systemd/system/service.d/10-timeout-abort.conf\n# This file is part of the systemd package.\n# See https://fedoraproject.org/wiki/Changes/Shorter_Shutdown_Timer.\n#\n# To facilitate debugging when a service fails to stop cleanly,\n# TimeoutStopFailureMode=abort is set to \"crash\" services that fail to stop in\n# the time allotted. This will cause the service to be terminated with SIGABRT\n# and a coredump to be generated.\n#\n# To undo this configuration change, create a mask file:\n\n[t+03:50/60:00 c69/300]"}]
