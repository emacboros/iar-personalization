uller.sh\n# Dry-run mode: CAMLOG_DRYRUN=1 prints without writing.\n#\n# v2 (aria c279, 2026-09-13): the RSSI cron (1/min, deployed 09-11) floods the\n# ~306-line logread ring buffer with crond lines; ~5h after the last real log\n# line the buffer is 100% crond and the filtered snapshot is empty. That state\n# is NOT a camera failure. The empty branch now records the buffer census\n# (total/crond) so the label is self-diagnosing:\n#   \"N N\"   = all-crond saturation (expected; camera fine)\n#   \"0 0\"   = logread genuinely empty (post-boot or cleared)\n#   \"N 0\"   = non-crond lines present but month-grep ate them (format regression)\n\nDEST=/var/lib/aria-fleet/camlog\nmkdir -p \"$DEST\"\nIPS=\"192.168.2.101 192.168.2.102 192.168.2.103 192.168.2.104 192.168.2.105 192.168.2.201 192.168.2.202 192.168.2.203\"\n\nfor ip in $IPS; do\n  C=$(curl -s -m 10 -i -X POST http://$ip/x/login.cgi -H \"Content-Type: application/json\" \\\n      -d '{\"username\":\"thingino\",\"password\":\"thingino\"}' | grep -oP 'thingino_session=\\K[^;]+')\n  [ -z \"$C\" ] && { echo \"$(date -u +%FT%TZ) $ip: login failed\" >&2; continue; }\n  OUT=$(curl -s -m 15 -b \"thingino_session=$C\" \\\n    \"http://$ip/x/run.cgi?cmd=$(echo -n 'logread | grep -v crond | tail -100' | base64 -w0)\" \\\n    | sed 's/<[^>]*>//g' | grep -E \"^Sep|^Jan|^Feb|^Mar|^Apr|^May|^Jun|^Jul|^Aug|^Oct|^Nov|^Dec\" | tail -100)\n  if [ -z \"$OUT\" ]; then\n    DETAIL=$(curl -s -m 15 -b \"thingino_session=$C\" \\\n      \"http://$ip/x/run.cgi?cmd=$(echo -n 'logread | wc -l; logread | grep -c crond' | base64 -w0)\" \\\n      | sed 's/<[^>]*>//g' | grep -E '^[0-9]+' | tr '\\n' ' ')\n\n[t+15:14/60:00 c40/300]"},{"role":"assistant","content":null,"tool_calls":[{"id":"call_7woc5gvb","function":{"index":0,"name":"execute_code_local","arguments":{"command":"KH=/tmp/aria_known_hosts; ssh -i /root/.ssh/id_ed25519 -o UserKnownHostsFile=$KH -o ConnectTimeout=8 root@10.66.0.5 'bash -s' <<'OUTER'\n# camlog snapshots are timestamped files? check dir listing + naming\nls /var/lib/aria-fleet/camlog/ | head -12\nOUTER"}}}]},{"role":"tool","content":"[20:48:05] 192.168.2....[+182 chars]
