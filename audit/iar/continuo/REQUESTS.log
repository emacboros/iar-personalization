400000\n  \"Exclusive upper bound of raw-eight-bit chars (byte #x100).\")\n\n(defun iar--string-has-raw-bytes (s)\n  \"Return non-nil if S contains raw-eight-bit chars.\"\n  (let ((i 0) (n (length s)) (found nil))\n    (while (and (not found) (< i n))\n      (let ((ch (aref s i)))\n        (when (and (>= ch iar--raw-byte-char-min)\n                   (< ch iar--raw-byte-char-max))\n          (setq found t)))\n      (setq i (1+ i)))\n    found))\n\n(defun iar--utf8-scrub (s)\n  \"Return S safe for json-serialize.\nRaw-eight-bit chars (invalid UTF-8 bytes) become U+FFFD.\nNon-string input passes through unchanged. Clean strings are\nreturned as-is (identity check first, no allocation).\"\n  (if (not (stringp s))\n      s\n    (let* ((in (if (multibyte-string-p s)\n                   s\n                 (decode-coding-string s 'utf-8 t))))\n      (if (not (stringp in))\n          s\n        (if (not (multibyte-string-p in))\n            in\n          (if (not (iar--string-has-raw-bytes in))\n              in\n            (mapconcat (lambda (ch)\n                         (if (and (>= ch iar--raw-byte-char-min)\n                                  (< ch iar--raw-byte-char-max))\n                             \"\\uFFFD\" (char-to-string ch)))\n                        in \"\"))))))\n\n(provide 'iar-utf8-scrub)"}}}]},{"role":"tool","content":"[11:35:52] Success: File written to '/root/.emacs.d/init.d/security/iar-utf8-scrub.el'\n[t+23:57/60:00 c78/300]"},{"role":"assistant","content":null,"tool_calls":[{"id":"call_v55uu07i","function":{"index":0,"name":"check_elisp","arguments":{"filepath":"/root/.emacs.d/init.d/security/iar-utf8-scrub.el"}}}]},{"role":"tool","content":"[11:35:56] ERRORS in iar-utf8-scrub.el:\n\nParenthesis error: Unmatched bracket or quote\n\n---\n\nIn toplevel form:\niar-utf8-scrub.el: Error: End of file during parsing\n[t+24:00/60:00 c79/300]"},{"role":"assistant","content":null,"tool_calls":[{"id":"call_obrjr1oe","function":{"index":0,"name":"write_file","