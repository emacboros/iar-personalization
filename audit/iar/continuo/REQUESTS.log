d 2026-08-31.)\nif [ ! -s \"$KNOWN_HOSTS\" ]; then\n  ssh-keyscan -T 5 10.66.0.5 > \"$KNOWN_HOSTS\" 2>/dev/null\nfi\n\nFAIL=0\nALERT_MSG...[+2405 chars]
