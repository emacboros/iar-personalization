look for msgs= followed by digits\n    if [[ \"$LAST_START\" =~ msgs=([0-9]+) ]]; then\n        MSGS=\"${BASH_REMATCH[1]}\"\n    else\n        # Fallback: try to find any number after msgs=\n        MSGS=$(echo \"$LAST_START\" | grep -o 'msgs=[0-9]*' | cut -d= -f2)\n        if [ -z \"$MSGS\" ]; then\n            echo \"WARNING: Could not extract msgs count from START line\" >&2\n            MSGS=0\n        fi\n    fi\nelse\n    MSGS=0\nfi\n\necho \"Current msgs count: $MSGS\"\necho \"Threshold: $THRESHOLD\"\n\nif [ \"$MSGS\" -ge \"$THRESHOLD\" ]; then\n    echo \"CONTEXT BUDGET EXCEEDED: msgs count $MSGS >= $THRESHOLD\"\n    # We would normally close the cycle and file a continuation task here.\n    # But note: we are in a script that might be called from a cycle.\n    # For now, we just return an exit code to indicate over budget.\n    exit 1\nelse\n    echo \"CONTEXT BUDGET OK: msgs count $MSGS < $THRESHOLD\"\n    exit 0\nfi\n[t+02:15/60:00 c13/300]"}]
