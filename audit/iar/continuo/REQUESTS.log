kdir -p \"$LOG_DIR\"\nDATE=\"$(date +%Y-%m-%d)\"\nLOG=\"$LOG_DIR/gpu-load-$DATE.csv\"\n\n# header once\n[ -f \"$LOG\" ] || echo \"epoch,l...[+13244 chars]
