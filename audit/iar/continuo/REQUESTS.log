nAW=$(awk -v s=\"$DAY 00\" -v u=\"$DAY 06\" '\n  /^\\[[0-9-]+ [0-9:]+\\] REQ .* START/ {\n    ts=substr($1\" \"$2,2,19)\n    if (ts >= s...[+2599 chars]
