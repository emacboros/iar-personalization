le a request ('-' = stdin body)\n#   relay list [state|all]                     list requests (default: open)\n#   relay show <id>                            print a request's full file\n#   relay digest                               Zulip-ready digest of open+relayed\n#   relay answer <id> <text>                   record Nacho's answer\n#   relay relay <id>                           open -> relayed (debrief delivery)\n#   relay hold <id> <reason>                   open -> held (visible filter)\n#   relay drop <id> <reason>                   open -> dropped (visible filter)\n#   relay bounce <id> <reason>                 misfiled: dropped with class reason\n# Ledger root: $ARIA_RELAY_ROOT (default /root/personalization/relay)\nset -euo pipefail\n\nROOT=\"${ARIA_RELAY_ROOT:-/root/personalization/relay}\"\nCLASSES=\"nacho-money nacho-external nacho-identity nacho-test nacho-arch nacho-security ours-direction\"\nSTATES=\"open relayed answered held dropped\"\n\ndie() { echo \"relay: $*\" >&2; exit 1; }\nlock=\"\"  # global, set by cmd_file; trap-safe under set -u\nfor s in $STATES; do mkdir -p \"$ROOT/$s\"; done\n\nnow() { date -u +%Y-%m-%dT%H:%MZ; }\n\nshort_id() { # filename -> id token (everything between date and slug)\n  # Filenames: YYYYMMDD-<filer>-NNNN-slug.md (per-filer) or legacy\n  # YYYYMMDD-NNNN-slug.md. The id is the filer+seq token. Extracted by\n  # anchored pattern, never substring (census-echo law, c71).\n  local b=\"$1\"\n  case \"$b\" in\n    [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[a-z]*-[0-9][0-9][0-9][0-9]-*)\n      echo \"${b#????????-}\" | cut -d- -f1-2 ;;\n    [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9]-*)\n      echo \"${b#????????-}\" | cut -d- -f1 ;;\n    *) echo \"\" ;;\n  esac\n}\n\nfind_req() { # find_req <id> -> prints path or dies\n\n[t+07:48/60:00 c97/300]"}]
