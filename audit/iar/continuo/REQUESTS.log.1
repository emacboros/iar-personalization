\n      (cl-loop for ctx in contexts do (delete-overlay ctx))))\n   (t                                   ;Anything at point\n    (when-let* ((ctx (gptel-context--at-point)))\n      (delete-overlay ctx)))))\n\n(defun gptel-context-remove-all (&optional verbose)\n  \"Remove all gptel context.\n\nIf VERBOSE is non-nil, ask for confirmation and message\nafterwards.\"\n  (interactive (list t))\n  (if (null gptel-context)\n      (when verbose (message \"No gptel context sources to remove.\"))\n    (when (or (not verbose) (y-or-n-p \"Remove all context? \"))\n      (cl-loop\n       for context in gptel-context\n       for (source . spec) = (ensure-list context)\n       if (bufferp source) do           ;Buffers and buffer regions\n       (mapc #'gptel-context-remove (plist-get spec :overlays))\n\n[t+05:01/60:00 c26/300]"},{"role":"assistant","content":null,"tool_calls":[{"id":"call_oqcxeit9","function":{"index":0,"name":"list_directory","arguments":{"path":"/root/personalization/tasks/iar/continuo"}}}]},{"role":"tool","content":"[07:12:52] ROADMAP.org\nSTATE.md\nTHREADS.org\nbare-repo-root-push-fixes.org\nbreaker-grace-compliance.org\ncontinuo/\nfailure-reduction/\ngptel-context-quadratic-cost/\ninteractive-bundle-nacho/\ntasks/\ntmp/\n[t+05:07/60:00 c27/300]"},{"role":"assistant","content":null,"tool_calls":[{"id":"call_3vddzh05","function":{"index":0,"name":"execute_code_local","arguments":{"command":"find /root/i.ar -name \"gptel-context.el\" -not -path \"*/elpa/*\" 2>/dev/null"}}}]},{"role":"tool","content":"[07:13:14] \n[t+05:29/60:00 c28/300]"}]
