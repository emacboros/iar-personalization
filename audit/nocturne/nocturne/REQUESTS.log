 (> len iar-digest-warn-chars)\n               (<= len iar-digest-hard-cap-chars))\n      (message \"[assembly] DIGEST [%s/%s] %d chars (warn at %d) -- injected full on every request; diet it\"\n               project-name personality-name len iar-digest-warn-chars))\n    (when (> len iar-digest-hard-cap-chars)\n      (message \"[assembly] DIGEST [%s/%s] HARD CAP: %d > %d chars, truncating to tail\"\n               project-name personality-name len iar-digest-hard-cap-chars)\n      (setq digest\n            (concat\n             (format \"[DIGEST TRUNCATED by hard cap: dropped %d chars from the head. The injection-math law lives at the head you cannot see: operational state belongs in ROADMAP.org, history in logs/journal/knowledge, world-state is ONE replaceable dated block. DIET THIS FILE at the next opportunity.]\\n\"\n                     (- len iar-digest-hard-cap-chars))\n             (substring digest (- len iar-digest-hard-cap-chars)))))\n    digest))\n\n\n;;; --- Cycle sequence counter (system-owned identity, c383) ---\n;;; The cycle-number duplication class (2026-09-17): cycles self-numbered\n;;; from generated headers (DIGEST/ROADMAP \"Last updated\" lines), and the\n\n[t+03:04/30:00 c31/300]"},{"role":"assistant","content":null,"tool_calls":[{"id":"call_yajmfhn4","function":{"index":0,"name":"execute_code_local","arguments":{"command":"cd /root/personalization && grep -n \"DIGEST\" audit/iar/aria/cycle-2026-09-18.log | tail -20 && echo \"=== assembly msgs ===\" && grep -n \"assembly\\]\" audit/iar/aria/cycle-2026-09-18.log | tail -10 && echo \"=== check other agents ===\" && grep -rn \"DIGEST TRUNCATED\\|warn at\" audit/iar/continuo/cycle-2026-09-18.log 2>/dev/null | tail -5"}}}]},{"role":"tool","content":"[16:07:43] 271:[assembly] DIGEST [iar/aria] 14825 chars (warn at 12000) -- injected full on every request; diet it\n413:[assembly] DIGEST [iar/aria] 14825 chars (warn at 12000) -- injected full on every request; diet it\n560:[assembly] DIGEST [iar/aria]