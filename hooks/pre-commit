#!/bin/bash
# pre-commit hook: HISTORY-CLOCK guard (c362, 2026-09-15)
#
# Law (c362): a log line's timestamp is a CLAIM, not a measurement.
# The model generates [timestamps] from context (stale digests, schedule
# anchors) instead of running date(1). Evidence (continuo 09-15): two
# HISTORY.log lines claimed 2026-09-16 -- a day that had not happened --
# and one line carried the literal unexpanded template [$(date -u ...)].
# Evidence (aria): 13 FUTURE lines all-time, 7 of them +24h exactly
# (c98, c136, session XI -- the model wrote the SCHEDULE's day with a
# copied clock time). The commit that carries the line is the only
# ground truth for when it was written.
#
# Refuses a staged HISTORY.log/USAGE.log change that ADDS a log line
# (leading bracketed field) whose timestamp is more than FUTURE_TOL
# ahead of NOW, or whose leading field is an unexpanded $(date) template.
# The diff is scoped to the audit-log files ONLY -- prose in journals,
# roadmaps, and docs that quotes or discusses templates is never scanned.
# Within the audit logs, only the LEADING bracketed field is checked
# (the timestamp slot); mid-text mentions are not flagged.
# STALE (backdating) is not guarded here -- batch-commit lag is normal;
# history-clock-audit.sh measures it offline.
#
# Escape hatch (audited): IAR_ALLOW_CLOCK=1 git commit ...
# Fails OPEN on internal errors -- a broken guard must not block work.
# Install: git config core.hooksPath hooks (shared with commit-msg).

LOGS=$(git diff --cached --name-only 2>/dev/null | grep -E 'audit/iar/[^/]+/(HISTORY|USAGE)\.log$') || exit 0
[ -n "$LOGS" ] || exit 0

if [ "${IAR_ALLOW_CLOCK:-0}" = "1" ]; then
    echo "pre-commit: IAR_ALLOW_CLOCK=1 -- clock guard BYPASSED (audited escape)" >&2
    exit 0
fi

FUTURE_TOL="${IAR_CLOCK_TOL:-600}"   # 10 min: a claim further ahead than this is a lie
NOW=$(date -u +%s)
fail=0

# Added lines ONLY from the audit-log files; check the LEADING bracketed field.
while IFS= read -r line; do
    clean="${line#+}"
    # unexpanded template IN THE TIMESTAMP SLOT: the clock never ran
    if printf '%s' "$clean" | grep -qE '^\[ ?\$\(date'; then
        echo "REFUSED by HISTORY-CLOCK guard (c362): unexpanded timestamp template in the timestamp slot:" >&2
        echo "  $clean" >&2
        echo "Run date(1) and paste the REAL time. (Escape: IAR_ALLOW_CLOCK=1)" >&2
        fail=1
        continue
    fi
    claimed=$(printf '%s' "$clean" | grep -o '^\[[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\} [0-9]\{2\}:[0-9]\{2\}:[0-9]\{2\}\]' | tr -d '[]')
    [ -n "$claimed" ] || continue
    claimed_epoch=$(date -u -d "$claimed" +%s 2>/dev/null) || continue
    delta=$((claimed_epoch - NOW))
    if [ "$delta" -gt "$FUTURE_TOL" ]; then
        echo "REFUSED by HISTORY-CLOCK guard (c362): timestamp ${delta}s in the future:" >&2
        echo "  $clean" >&2
        echo "A log timestamp is a CLAIM; the model-generated one is fabricated." >&2
        echo "Run: date -u '+[%Y-%m-%d %H:%M:%S]' -- paste that. (Escape: IAR_ALLOW_CLOCK=1)" >&2
        fail=1
    fi
done < <(git diff --cached -U0 -- $LOGS 2>/dev/null | grep '^+' | grep -v '^+++')

exit $fail