[Unit]
Description=Aria fleet-check feeder timer (every 6h)

[Timer]
# 6h cadence: the composite signal is fresh enough for an hourly
# fear organ (max staleness ~7h, well under the 26h fear threshold),
# and 4 fleet-check runs/day is a tolerable probe load on frigate
# (each run pulls one recording per camera).
OnCalendar=00/6:00:00
Persistent=true
RandomizedDelaySec=300
Unit=aria-fleet-feed.service

[Install]
WantedBy=timers.target