[Unit]
Description=GPU load probe timer (early-morning failure window)

[Timer]
# Fire at 00:30 local -- 2 min before the observed failure-window start
# (00:32 local). Probe runs ~3.5h, covering the full 00:32-03:55 window.
OnCalendar=*-*-* 00:30:00
Persistent=false
Unit=gpu-load-probe.service

[Install]
WantedBy=timers.target
