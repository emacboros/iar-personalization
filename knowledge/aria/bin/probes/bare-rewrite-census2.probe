### bare repo census: one-line per repo (dangling HEAD + root-owned)
cd /home/git/repos
for r in i.ar iar-infrastructure gptel iar-personalization concepts infrastructure notes wiki; do head=$(git -C $r.git symbolic-ref HEAD 2>/dev/null); git -C $r.git rev-parse --verify "$head" >/dev/null 2>&1 && hb=EXISTS || hb=DANGLING; ro=$(find $r.git -user root 2>/dev/null | wc -l); echo "$r.git HEAD=$head branch=$hb root-owned=$ro"; done