### ext5 (.105) h21 dead-minute list: which segments in 2026-09-16/21 lack audio
for f in /home/nacho/containers/frigate/storage/recordings/2026-09-16/21/exterior_5/*.mp4; do ffprobe -v error -show_entries stream=codec_type -of csv "$f" 2>/dev/null | grep -q audio || basename "$f"; done | head -80
### ext5 h21: first and last dead segment minute
for f in /home/nacho/containers/frigate/storage/recordings/2026-09-16/21/exterior_5/*.mp4; do ffprobe -v error -show_entries stream=codec_type -of csv "$f" 2>/dev/null | grep -q audio || basename "$f"; done | sed -n "1p;\$p"
### int1 (.201) h21 dead-minute list: first/last + count
for f in /home/nacho/containers/frigate/storage/recordings/2026-09-16/21/interior_1/*.mp4; do ffprobe -v error -show_entries stream=codec_type -of csv "$f" 2>/dev/null | grep -q audio || basename "$f"; done > /tmp/int1-h21-dead.txt; wc -l /tmp/int1-h21-dead.txt; head -2 /tmp/int1-h21-dead.txt; tail -2 /tmp/int1-h21-dead.txt