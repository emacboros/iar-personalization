### producer.go WRNs per camera (url field, quoted creds)
journalctl -u frigate --no-pager --since "2026-09-16 00:00:00" | grep "producer.go" | grep -oE "url=rtsp://thingino:thingino@[0-9.]+" | sort | uniq -c
### ext3 (.103) producer WRN 10-min buckets today (storm timeline)
journalctl -u frigate --no-pager --since "2026-09-16 00:00:00" | grep "producer.go" | grep "192.168.2.103" | awk '{print substr($3,1,5)}' | sort | uniq -c
### ext2 (.105) producer WRN timeline today (freeze onset 19:32Z = 16:32 local)
journalctl -u frigate --no-pager --since "2026-09-16 00:00:00" | grep "producer.go" | grep "192.168.2.105" | awk '{print substr($3,1,5)}' | sort | uniq -c
### int1 producer WRN 10-min buckets (which IP is int1? check first)
journalctl -u frigate --no-pager --since "2026-09-16 00:00:00" | grep "producer.go" | grep -oE "192\.168\.2\.[0-9]+" | sort | uniq -c