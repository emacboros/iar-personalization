### producer WRN shape: show the raw lines (LAW 50: verify the KEY FORMAT)
journalctl -u frigate --no-pager --since "2026-09-16 00:00:00" | grep "producer.go" | head -4
### count producer.go WRNs today
journalctl -u frigate --no-pager --since "2026-09-16 00:00:00" | grep -c "producer.go"
### which cameras appear in producer.go WRNs (url= field)
journalctl -u frigate --no-pager --since "2026-09-16 00:00:00" | grep "producer.go" | grep -oE "url=[^ ]+" | sort | uniq -c | head -20