### ext3 reconnect WRNs (producer.go read i/o timeout) 10-min buckets today
journalctl -u frigate --no-pager --since "2026-09-16 00:00:00" | grep "producer.go" | grep "exterior_3" | awk '{print substr($3,1,5)}' | sort | uniq -c | tail -40
### ext2 producer WRN timeline today (freeze onset 19:32Z = 16:32 local)
journalctl -u frigate --no-pager --since "2026-09-16 00:00:00" | grep "producer.go" | grep "exterior_2" | awk '{print substr($3,1,5)}' | sort | uniq -c
### int1 producer WRN 10-min buckets (the ~100/day stall class)
journalctl -u frigate --no-pager --since "2026-09-16 00:00:00" | grep "producer.go" | grep "interior_1" | awk '{print substr($3,1,5)}' | sort | uniq -c | tail -40
### ext5 producer WRN 10-min buckets (68 dead at h21)
journalctl -u frigate --no-pager --since "2026-09-16 00:00:00" | grep "producer.go" | grep "exterior_5" | awk '{print substr($3,1,5)}' | sort | uniq -c | tail -20
### all producer.go WRN counts per camera today
journalctl -u frigate --no-pager --since "2026-09-16 00:00:00" | grep "producer.go" | grep -oE "rtsp://[a-z0-9.:/@]+" | sort | uniq -c