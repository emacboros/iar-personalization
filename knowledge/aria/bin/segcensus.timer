[Unit]
Description=Aria segment-census puller timer (hourly)

[Timer]
# Hourly at :05 past, so the previous UTC hour is fully complete
# (frigate closes segments on 10s boundaries; :05 gives 5min slack
# for the last segment to flush).
OnCalendar=*-*-* *:05:00
Persistent=true
RandomizedDelaySec=60
Unit=segcensus.service

[Install]
WantedBy=timers.target