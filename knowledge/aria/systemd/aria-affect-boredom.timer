[Unit]
Description=Aria boredom organ timer (daily, 14:00 local)

[Timer]
# 14:00 America/Argentina/Buenos_Aires = 17:00 UTC. Boredom's
# thresholds are in DAYS (3/7/30); an hourly tick would be
# habituation noise (emit-on-delta law). One honest daily read.
OnCalendar=*-*-* 17:00:00 UTC
Persistent=true
RandomizedDelaySec=120
Unit=aria-affect-boredom.service

[Install]
WantedBy=timers.target